# sh2-server settings for docker compose. Copy to .env next to docker-compose.yml and edit; every line
# is optional and the values shown are the defaults. .env is git-ignored: it may hold secrets.

# ---- sh2-server ----
# SH2_PORT=8730                      # host port; prefix an address to bind one interface: 127.0.0.1:8730
# SH2_JWT_SECRET=                    # empty = generated once and kept in ./data/jwt.secret
# SH2_CONSUMER_TOKEN=                # empty = the x-consumer-token header is not required
# SH2_MEM_LIMIT=256m

# ---- Routing proxy (/routing/brouter/*, /routing/valhalla/*, /routing/status) ----
# Point these at the engines started below (service names resolve inside the compose network), or at
# any other BRouter/Valhalla server. Unset = that engine answers 503.
# SH2_BROUTER_URL=http://brouter:17777
# SH2_VALHALLA_URL=http://valhalla:8002
# SH2_ROUTING_AUTH=false             # true = callers must send the user's access JWT (x-access-token)
# SH2_ROUTING_TIMEOUT_MS=120000      # per proxied request, until the last byte
# SH2_ROUTING_MAX_BYTES=16777216     # per proxied response

# ---- Which optional engines `docker compose up -d` starts ----
# COMPOSE_PROFILES=brouter           # brouter, valhalla, or brouter,valhalla

# ---- BRouter (profile "brouter") ----
# BROUTER_IMAGE=sh2-brouter:1.7.10   # tag given to the local build
# BROUTER_BUILD_CONTEXT=https://github.com/abrensch/brouter.git#v1.7.10
# BROUTER_PORT=17777                 # host port of the native API; 127.0.0.1:17777 keeps it local
# BROUTER_BBOX=-9.5,35.8,4.5,43.9    # minLon,minLat,maxLon,maxLat -> every 5° tile it touches
# BROUTER_TILES=                     # explicit tiles instead of the bbox, e.g. "W5_N40 E0_N40"
# BROUTER_SEGMENTS_URL=https://brouter.de/brouter/segments4/
# BROUTER_SEGMENTS_UPDATE=false      # true = on start, re-download the tiles that changed upstream
# BROUTER_SEGMENTS_VOLUME=brouter-segments   # named volume, or a host path such as /srv/brouter/segments4
# BROUTER_MAX_THREADS=2
# BROUTER_JAVA_OPTS=-Xmx256M -Xms128M -Xmn16M -XX:+UseSerialGC -XX:ActiveProcessorCount=2 -DmaxRunningTime=110 -DuseRFCMimeType=false
# BROUTER_MEM_LIMIT=512m

# ---- Valhalla (profile "valhalla") ----
# VALHALLA_IMAGE=ghcr.io/valhalla/valhalla-scripted:3.9.1
# VALHALLA_PORT=8002
# VALHALLA_PBF_URL=https://download.geofabrik.de/europe/spain-latest.osm.pbf
# VALHALLA_THREADS=2
# VALHALLA_FORCE_REBUILD=False       # True for one start to rebuild the tiles (see README.md)
# VALHALLA_DATA_VOLUME=valhalla-data # named volume, or a host path
# VALHALLA_MEM_LIMIT=6g
