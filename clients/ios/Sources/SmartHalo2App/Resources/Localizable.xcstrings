    "The app stops connecting to it. Its password stays in the Keychain, so pairing the same Halo again won't need a recovery." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The app stops connecting to it. Its password stays in the Keychain, so pairing the same Halo again won't need a recovery."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La app dejará de conectarse a él. Su contraseña se queda en el Llavero, así que volver a emparejar el mismo Halo no necesitará recuperación."
          }
        }
      }
    },
    "The demo route isn't available." : {
      "extractionState" : "manual",
