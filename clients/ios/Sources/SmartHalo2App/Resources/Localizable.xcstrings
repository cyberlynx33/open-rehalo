    },
    "This Halo doesn't accept this iPhone's password yet. Re-pair it to take control." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This Halo doesn't accept this iPhone's password yet. Re-pair it to take control."
