    "Why: the firmware only reloads the (now-cleared) password at boot. There is no safe over-the-air reboot — the ring rejects reboot/standby commands unless an app is already paired." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Why: the firmware only reloads the (now-cleared) password at boot. There is no safe over-the-air reboot — the ring rejects reboot/standby commands unless an app is already paired."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Por qué: el firmware solo recarga la contraseña (ya borrada) al arrancar. No hay un reinicio inalámbrico seguro: el anillo rechaza los comandos de reinicio/reposo si no hay una app emparejada."
          }
        }
      }
    },
