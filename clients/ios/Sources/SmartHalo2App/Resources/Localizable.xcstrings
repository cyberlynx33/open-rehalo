    "Saves every GPS fix, what the screen showed and what the ring was told, to find navigation bugs. Includes your route: share it only if you want to." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saves every GPS fix, what the screen showed and what the ring was told, to find navigation bugs. Includes your route: share it only if you want to."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guarda cada posición GPS, lo que mostró la pantalla y lo que se le dijo al anillo, para encontrar fallos de navegación. Incluye tu ruta: compártela solo si quieres."
          }
        }
      }
    },
