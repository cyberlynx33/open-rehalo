      }
    },
    "The Halo is un-paired. Due to a firmware quirk it keeps its old password until it restarts once: disconnect and reconnect the battery, or let it drain. Wait here — we'll notice when it comes back." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The Halo is un-paired. Due to a firmware quirk it keeps its old password until it restarts once: disconnect and reconnect the battery, or let it drain. Wait here — we'll notice when it comes back."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El Halo ya está desemparejado. Por una peculiaridad del firmware conserva la contraseña antigua hasta que se reinicia una vez: desconecta y vuelve a conectar la batería, o deja que se agote. Espera aquí: detectaremos cuándo vuelve."
          }
        }
      }
    },
    "The ring powers off; wake it by plugging it in or tapping it." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ring powers off; wake it by plugging it in or tapping it."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El anillo se apaga; despiértalo enchufándolo o tocándolo."
          }
        }
      }
    },
    "The ring will stop guiding you." : {
      "extractionState" : "manual",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The ring will stop guiding you."
