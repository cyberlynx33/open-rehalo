        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este Halo aún no acepta la contraseña de este iPhone. Vuelve a emparejarlo para controlarlo."
          }
        }
      }
    },
    "This Halo has a password this iPhone doesn't know, probably from the old app. We'll reset it and give it this iPhone's password, kept in your Keychain." : {
      "extractionState" : "manual",
